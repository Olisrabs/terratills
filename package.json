    "description":  "TerraTills - Nigeria-first agricultural services marketplace unified dashboard",
    "main":  "server/index.js",
    "scripts":  {
                    "dev":  "concurrently \"tsx watch server/src/server.ts\" \"vite\"",
                    "dev:server":  "tsx watch server/src/server.ts",
                    "dev:client":  "vite",
                    "build":  "vite build",
                    "start":  "tsx server/src/server.ts",
                    "test":  "node server/tests/backend.test.js",
                    "dev:api":  "tsx watch server/src/server.ts",
                    "dev:new":  "concurrently \"tsx watch server/src/server.ts\" \"vite\"",
                    "typecheck":  "tsc --noEmit",
                    "start:new":  "tsx server/src/server.ts"
                },
    "keywords":  [
