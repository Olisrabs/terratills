NODE_ENV=development
PORT=5000

# Supabase — create project at https://supabase.com and copy from Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Sessions — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change_this_to_64_random_hex_chars_minimum_32_bytes
OTP_HMAC_SECRET=change_this_to_64_random_hex_chars_minimum_32_bytes

# Frontend origin (Vite dev server)
APP_ORIGIN=http://localhost:5173

# SMS driver: "console" (dev) or "twilio" (prod — requires TWILIO_* vars)
SMS_DRIVER=console

# Bach payment gateway — get credentials from Bach after onboarding
BACH_API_BASE=https://api.bach.ng
BACH_SECRET_KEY=TODO_get_from_bach
BACH_WEBHOOK_SECRET=TODO_get_from_bach

# Feature flags
PAYOUT_AUTOMATION=false
ENABLE_DEV_SWITCH_USER=false
